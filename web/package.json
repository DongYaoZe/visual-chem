{
	"name": "web",
	"private": true,
	"version": "0.1.0-alpha.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/generate-sitemap.mjs && vite build && node scripts/stamp-404.mjs",
		"preview": "vite preview",
		"serve:pages": "node scripts/serve-pages.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"audit:visual": "node scripts/capture-audit.mjs",
		"audit:production": "node scripts/audit-production.mjs",
		"validate": "npm run lint && npm run check && npm run test:unit -- --run && npm run build"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/katex": "^0.16.8",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"katex": "^0.17.0"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
