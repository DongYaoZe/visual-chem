type: software
version: 0.1.0-alpha.1
date-released: 2026-07-16
license: MIT
repository-code: "https://github.com/DongYaoZe/visual-chem"
url: "https://dongyaoze.github.io/visual-chem/"
keywords:
  - chemistry education
  - narrative visualization
  - phase equilibrium
  - explorable explanation
  - open educational resources
